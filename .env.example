# Copy this file to .env and replace the placeholder with a URL-safe local password.
POSTGRES_DB=myfitnessplan
POSTGRES_USER=myfitnessplan
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Used when running FastAPI on the host. Compose supplies its own container-network URL.
DATABASE_URL=postgresql+psycopg://myfitnessplan:replace-with-a-local-development-password@localhost:5433/myfitnessplan

# Authentication settings. CORS_ALLOWED_ORIGINS is a JSON array of exact browser origins.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SESSION_LIFETIME_SECONDS=604800
# The current application runs over local HTTP. Set true only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Optional until Google Sign-In is implemented in milestone 5, stage 8.
GOOGLE_CLIENT_ID=

POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=5173
