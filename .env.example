# Copy this file to .env and replace the placeholder with a URL-safe local password.
POSTGRES_DB=myfitnessplan
POSTGRES_USER=myfitnessplan
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Used when running FastAPI on the host. Compose supplies its own container-network URL.
DATABASE_URL=postgresql+psycopg://myfitnessplan:replace-with-a-local-development-password@localhost:5433/myfitnessplan

# Authentication settings. The app permits the two documented local Vite origins.
SESSION_LIFETIME_SECONDS=604800
# The current application runs over local HTTP. Set true only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# OAuth 2.0 Web client ID. This is a public identifier, not a client secret.
GOOGLE_CLIENT_ID=

# Anthropic API configuration. ANTHROPIC_API_KEY is a secret; use a real value only in ignored .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=35
ANTHROPIC_MAX_OUTPUT_TOKENS=1000
# Keep retries at zero so one user action cannot silently create multiple billable requests.
ANTHROPIC_MAX_RETRIES=0
ANTHROPIC_TEMPERATURE=0.2

POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=5173
